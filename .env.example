# Copy this file to .env and fill in real values. NEVER commit a real .env.
# .env is git-ignored by default.

# --- Database (MongoDB — only database variable) ---
# Free MongoDB Atlas cluster (see README.md for setup steps).
# Local dev can use Atlas too, or a local mongod:
#   DATABASE_URL="mongodb://localhost:27017/familycard"
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/familycard?retryWrites=true&w=majority"

# --- Better Auth ---
# Generate a long random secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Local dev:
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Vercel) — set both to your deployed URL, e.g.:
# BETTER_AUTH_URL="https://family-card-search.vercel.app"
# NEXT_PUBLIC_APP_URL="https://family-card-search.vercel.app"

# --- Social login (optional — see README.md "সোশ্যাল লগইন" section) ---
# Google OAuth client (Google Cloud Console). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook app (Meta for Developers). Leave empty to disable Facebook login.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
